rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {

        match /rooms/{roomId} {

            /*
             * Users must be authenticated.
             */

            allow read, write:
                if request.auth != null;


            /*
             * ICE candidates.
             */

            match /candidates/{candidateId} {

                allow read, write:
                    if request.auth != null;

            }

        }

    }

}